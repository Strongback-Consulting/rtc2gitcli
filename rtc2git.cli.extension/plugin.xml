<?xml version="1.0" encoding="UTF-8"?>
<?eclipse version="3.4"?>
<plugin>
   <extension
         point="com.ibm.team.rtc.cli.infrastructure.subcommand">
      <subcommand
            class="to.rtc.cli.migrate.git.MigrateToGit"
            id="to.rtc.cli.migrate.git.MigrateToGit"
            initpolicy="uri/argument/ancestor"
            name="migrate-to-git"
            options="to.rtc.cli.migrate.git.MigrateToGitOptions"
            shortHelp="migrate to git">
      </subcommand>
      <subcommand
            class="to.rtc.cli.migrate.zos.ZosInventoryCmd"
            id="to.rtc.cli.migrate.zos.ZosInventoryCmd"
            initpolicy="scratch"
            name="migrate-inventory"
            options="to.rtc.cli.migrate.zos.ZosInventoryOptions"
            shortHelp="read-only z/OS inventory of a stream before migration">
      </subcommand>
   </extension>
</plugin>
