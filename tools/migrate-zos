#!/bin/sh
# Migrates one EWM z/OS stream into a Git repository for DBB zBuilder.
#
# Usage: tools/migrate-zos -r <repo> -s <stream> -x <sysdef-export.xml> -w <work-dir> -t <target-repo>
#                          [-m <migration.properties>] [-c <schema.json>] [-S <source-ws>] [-T <target-ws>]
#
#   -r  repository URI or nickname for scm (log in first: scm login -r <uri> -u <user> -n <nick> -c)
#   -s  stream to migrate
#   -x  system definition export (XML from the Build System Toolkit's ld: Ant tasks)
#   -w  work folder: the migration mirror goes to <work>/mirror, the shared zBuilder
#       configuration to <work>/zbuilder (both reused when the script runs again)
#   -t  new repository in the target layout (zOSsrc -> src, dbb-app.yaml); must not exist
#   -m  migration properties (default: migration.properties of this repository)
#   -c  zBuilder JSON schema: every generated YAML file must validate against it
#   -S/-T  names of the source/target repository workspaces (default: rtc2git-<stream>-source/-target);
#       created from the stream when they do not exist
#
# Environment: SCM (default: scm on the PATH) must be an SCM Tools with Enterprise Extensions and the
# migrate-to-git plugin (tools/assemble-ee-scmtools.sh, tools/install-scmtools-plugin.sh); uv runs ewm2zbuilder.
#
# Steps:
#   1. scm migrate-to-git --stream: mirror of the stream's history, with .ewm/zos-metadata.json and
#      z/OS code pages in .gitattributes (resumes when run again)
#   2. ewm2zbuilder: shared zBuilder configuration and language-map.yaml from the system definitions
#   3. ewm2zbuilder layout: the target repository, plus dbb-app.yaml from the newest metadata
set -eu

HERE=$(cd "$(dirname "$0")/.." && pwd)
SCM=${SCM:-scm}
REPO= STREAM= EXPORT= WORK= TARGET= SCHEMA= SOURCE_WS= TARGET_WS=
PROPERTIES="$HERE/migration.properties"

while getopts r:s:x:w:t:m:c:S:T: opt; do
  case $opt in
    r) REPO=$OPTARG ;; s) STREAM=$OPTARG ;; x) EXPORT=$OPTARG ;; w) WORK=$OPTARG ;;
    t) TARGET=$OPTARG ;; m) PROPERTIES=$OPTARG ;; c) SCHEMA=$OPTARG ;;
    S) SOURCE_WS=$OPTARG ;; T) TARGET_WS=$OPTARG ;;
    *) sed -n '2,25p' "$0" >&2; exit 2 ;;
  esac
done
for required in REPO STREAM EXPORT WORK TARGET; do
  eval "value=\${$required}"
  [ -n "$value" ] || { echo "missing option for $required (see $0 header)" >&2; exit 2; }
done
[ -f "$EXPORT" ] || { echo "system definition export not found: $EXPORT" >&2; exit 1; }
[ -f "$PROPERTIES" ] || { echo "migration properties not found: $PROPERTIES" >&2; exit 1; }
[ ! -e "$TARGET" ] || { echo "target exists already: $TARGET" >&2; exit 1; }
SLUG=$(printf '%s' "$STREAM" | tr -c 'A-Za-z0-9' '-' | tr 'A-Z' 'a-z' | sed 's/--*/-/g; s/^-//; s/-$//')
SOURCE_WS=${SOURCE_WS:-rtc2git-$SLUG-source}
TARGET_WS=${TARGET_WS:-rtc2git-$SLUG-target}
SCHEMA_ARG=
[ -z "$SCHEMA" ] || SCHEMA_ARG="--schema $SCHEMA"

# an empty .jazz5 makes a new directory acceptable to scm as the sandbox given with -d
mkdir -p "$WORK/mirror/.jazz5"
WORK=$(cd "$WORK" && pwd)

echo "== 1/3 migrate [$STREAM] into $WORK/mirror"
"$SCM" migrate-to-git -r "$REPO" -m "$PROPERTIES" --stream "$STREAM" -d "$WORK/mirror" "$SOURCE_WS" "$TARGET_WS"
git -C "$WORK/mirror" rev-parse --verify -q HEAD >/dev/null || { echo "migration produced no commits" >&2; exit 1; }
git -C "$WORK/mirror" cat-file -e HEAD:.ewm/zos-metadata.json 2>/dev/null \
  || echo "warning: no .ewm/zos-metadata.json in the mirror (no z/OS metadata in this stream?)" >&2

echo "== 2/3 shared zBuilder configuration from $EXPORT into $WORK/zbuilder"
# shellcheck disable=SC2086
(cd "$HERE/ewm2zbuilder" && uv run ewm2zbuilder "$EXPORT" -o "$WORK/zbuilder" $SCHEMA_ARG)

echo "== 3/3 target repository $TARGET"
# shellcheck disable=SC2086
(cd "$HERE/ewm2zbuilder" && uv run ewm2zbuilder layout "$WORK/mirror" "$TARGET" \
  --language-map "$WORK/zbuilder/language-map.yaml" $SCHEMA_ARG)

echo "Done. Review $WORK/zbuilder/conversion-report.txt; the shared configuration in $WORK/zbuilder"
echo "goes to the build configuration repository, $TARGET is the application repository."
