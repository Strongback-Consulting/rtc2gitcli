<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<?pde version="3.8"?>
<target name="EWM 7.2 SCM Tools">
  <locations>
    <!-- EWM 7.2 SCM Tools with Enterprise Extensions (tools/assemble-ee-scmtools.sh); SCMTOOLS_HOME is its scmtools folder -->
    <location path="${env_var:SCMTOOLS_HOME}/eclipse/plugins" type="Directory"/>
  </locations>
  <targetJRE path="org.eclipse.jdt.launching.JRE_CONTAINER/org.eclipse.jdt.internal.debug.ui.launcher.StandardVMType/JavaSE-17"/>
</target>
